<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OrangeHRM" parallel="methods" thread-count="3">
	<listeners>
		<listener class-name="com.orangehrm.listners.TestListner"></listener>
	</listeners>
	<!-- Chrome -->
	<test name="Chrome Tests">
	  <parameter name="browser" value="chrome"/>
		<classes>
			<class name="com.orangehrm.test.LoginPageTest" />
			<class name="com.orangehrm.test.HomePageTest" />
		</classes>
	</test>
	<!-- Firefox -->
	<test name="Firefox Tests">
	  <parameter name="browser" value="firefox"/>
		<classes>
			<class name="com.orangehrm.test.LoginPageTest" />
			<class name="com.orangehrm.test.HomePageTest" />
		</classes>
	</test>
</suite>